enum approval_keputusan {
  approve
  reject
}

enum approval_tipe_dokumen {
  spk
  surat_jalan
}

enum role {
  admin
  kepala_produksi
  owner
  tim_logistik
  client
}

enum status_dokumen {
  draft
  menunggu_approval
  disetujui
  ditolak
}

enum status_pengantaran {
  menunggu
  dalam_perjalanan
  tiba_di_lokasi
  diterima_client
}

enum status_unit {
  antrian
  produksi
  finishing
  menunggu_srut
  srut_selesai
  selesai
  pengantaran
  diterima
}

enum stok_log_tipe {
  restock
  bom_keluar
  bom_kembali
}

table antrian {
  id text [pk, not null]
  kode_antrian varchar(20) [not null, unique]
  status status_unit [not null, default: 'antrian']
  perlu_srut boolean [not null, default: false]
  nama_pelanggan varchar(255) [not null]
  jenis_karoseri varchar(100) [not null]
  merk_chassis varchar(100)
  tipe_chassis varchar(100)
  nopol_kendaraan varchar(20)
  no_rangka varchar(50)
  no_mesin varchar(50)
  tanggal_masuk timestamp
  catatan text
  created_by_id text [not null]
  client_user_id text
  archived_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table approval_log {
  id text [pk, not null]
  tipe_dokumen approval_tipe_dokumen [not null]
  keputusan approval_keputusan [not null]
  catatan text
  approver_id text [not null]
  spk_id text
  surat_jalan_id text
  created_at timestamp [not null, default: `now()`]
}

table bom_item {
  id text [pk, not null]
  spk_id text [not null]
  material_id text [not null]
  jumlah_dibutuhkan real [not null]
  jumlah_terpakai real [not null, default: 0]
}

table bom_template {
  id text [pk, not null]
  jenis_karoseri varchar(100) [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table bom_template_item {
  id text [pk, not null]
  bom_template_id text [not null]
  material_id text [not null]
  jumlah_standar real [not null]
}

table material {
  id text [pk, not null]
  nama varchar(255) [not null]
  satuan varchar(50) [not null]
  stok_saat_ini real [not null, default: 0]
  stok_minimum real [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table spk {
  id text [pk, not null]
  nomor_spk varchar(20) [unique]
  antrian_id text [not null, unique]
  status status_dokumen [not null, default: 'draft']
  spesifikasi text
  catatan text
  kepala_konfirmasi_at timestamp
  material_sisa_konfirmasi_at timestamp
  created_by_id text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table status_log {
  id text [pk, not null]
  antrian_id text [not null]
  status_dari status_unit [not null]
  status_ke status_unit [not null]
  catatan text
  user_id text [not null]
  created_at timestamp [not null, default: `now()`]
}

table stok_log {
  id text [pk, not null]
  material_id text [not null]
  tipe stok_log_tipe [not null]
  jumlah real [not null]
  catatan text
  user_id text [not null]
  spk_id text
  created_at timestamp [not null, default: `now()`]
}

table surat_jalan {
  id text [pk, not null]
  antrian_id text [not null, unique]
  nomor_surat varchar(50) [not null, unique]
  status status_dokumen [not null, default: 'draft']
  alamat_tujuan text
  catatan text
  status_pengantaran status_pengantaran [not null, default: 'menunggu']
  created_by_id text [not null]
  assigned_to_id text
  foto_bukti_url text
  bukti_by_id text
  bukti_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table tanda_terima {
  id text [pk, not null]
  antrian_id text [not null, unique]
  nama_pengirim varchar(255) [not null]
  no_telp_pengirim varchar(20)
  nopol_pengirim varchar(20)
  kondisi_sasis text
  catatan text
  foto_kondisi_urls text[] [not null, default: `[]`]
  foto_surat_url text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table users {
  id text [pk, not null]
  nama varchar(255) [not null]
  username varchar(100) [not null, unique]
  password text [not null]
  role role [not null]
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

ref antrian_created_by_id_users_id_fk: antrian.created_by_id > users.id [delete: no action, update: no action]

ref antrian_client_user_id_users_id_fk: antrian.client_user_id > users.id [delete: no action, update: no action]

ref approval_log_approver_id_users_id_fk: approval_log.approver_id > users.id [delete: no action, update: no action]

ref approval_log_spk_id_spk_id_fk: approval_log.spk_id > spk.id [delete: no action, update: no action]

ref approval_log_surat_jalan_id_surat_jalan_id_fk: approval_log.surat_jalan_id > surat_jalan.id [delete: no action, update: no action]

ref bom_item_spk_id_spk_id_fk: bom_item.spk_id > spk.id [delete: no action, update: no action]

ref bom_item_material_id_material_id_fk: bom_item.material_id > material.id [delete: no action, update: no action]

ref bom_template_item_bom_template_id_bom_template_id_fk: bom_template_item.bom_template_id > bom_template.id [delete: no action, update: no action]

ref bom_template_item_material_id_material_id_fk: bom_template_item.material_id > material.id [delete: no action, update: no action]

ref spk_antrian_id_antrian_id_fk: spk.antrian_id > antrian.id [delete: no action, update: no action]

ref spk_created_by_id_users_id_fk: spk.created_by_id > users.id [delete: no action, update: no action]

ref status_log_antrian_id_antrian_id_fk: status_log.antrian_id > antrian.id [delete: no action, update: no action]

ref status_log_user_id_users_id_fk: status_log.user_id > users.id [delete: no action, update: no action]

ref stok_log_material_id_material_id_fk: stok_log.material_id > material.id [delete: no action, update: no action]

ref stok_log_user_id_users_id_fk: stok_log.user_id > users.id [delete: no action, update: no action]

ref stok_log_spk_id_spk_id_fk: stok_log.spk_id > spk.id [delete: no action, update: no action]

ref surat_jalan_antrian_id_antrian_id_fk: surat_jalan.antrian_id > antrian.id [delete: no action, update: no action]

ref surat_jalan_created_by_id_users_id_fk: surat_jalan.created_by_id > users.id [delete: no action, update: no action]

ref surat_jalan_assigned_to_id_users_id_fk: surat_jalan.assigned_to_id > users.id [delete: no action, update: no action]

ref surat_jalan_bukti_by_id_users_id_fk: surat_jalan.bukti_by_id > users.id [delete: no action, update: no action]

ref tanda_terima_antrian_id_antrian_id_fk: tanda_terima.antrian_id > antrian.id [delete: no action, update: no action]